echo "acme - the F12 text editor"
echo ""
echo "The editor is built into F12. Open a file with: acme <file>"
echo ""
echo "Commands are single letters:"
echo "  i insert    d delete line   x delete char"
echo "  g get       w write         l look"
echo "  q quit      h list again"
echo ""
echo "Arrows move, Home and End reach the ends of the line, PgUp and PgDn"
echo "scroll. The cursor is the highlighted cell."
echo ""
echo "Over a serial console you see confirmations and file sizes, not text."